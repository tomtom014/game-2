[sub_resource type="GDScript" id="GDScript_15vrf"]
resource_name = "gate"
script/source = "extends StaticBody2D

@export var sprite:AnimatedSprite2D
@export var blocker:CollisionShape2D
@export var interact:Area2D

var opened:=false

func _ready() -> void:
	sprite.stop()
	sprite.animation=&\"opening\"
	sprite.frame=0

func _unhandled_input(event: InputEvent) -> void:
	if opened or not event.is_action_pressed(\"interact\"):
		return
	for body in interact.get_overlapping_bodies():
		if not body.is_in_group(\"player\") or body.is_dead:
			continue
		if not body.try_use_key():
			continue
		opened = true
		get_viewport().set_input_as_handled()
		sprite.play(\"opening\")
		await sprite.animation_finished
		blocker.set_deferred(\"disabled\", true)
"

