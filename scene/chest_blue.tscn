[gd_scene format=3 uid="uid://caemsfg4fng2u"]

[ext_resource type="Texture2D" uid="uid://bnqeem03dhdjt" path="res://tiles/tiles/GrassTileset/Props.png" id="1_1svun"]

[sub_resource type="GDScript" id="GDScript_j3j0o"]
resource_name = "chest_blue"
script/source = "extends Area2D

@export var closed_texture: Texture2D
@export var opened_texture: Texture2D

var is_open := false


func _ready() -> void:
	$Sprite2D.texture = closed_texture
	$Sprite2D.scale = Vector2(1, 1)


func _unhandled_input(event: InputEvent) -> void:
	if is_open or not is_visible_in_tree():
		return
	if not event.is_action_pressed(\"interact\") or event.is_echo():
		return

	for body in get_overlapping_bodies():
		if body.is_in_group(\"player\"):
			if body.is_dead:
				continue
			is_open = true
			$Sprite2D.texture = opened_texture
			$Sprite2D.scale = Vector2(1, 1)
			body.add_coin()
			get_viewport().set_input_as_handled()
			break
"

