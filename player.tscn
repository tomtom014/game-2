[sub_resource type="GDScript" id="GDScript_4flbx"]
script/source = "extends CharacterBody2D

@export var sprite : AnimatedSprite2D
@export var movement_speed : float = 500

@export var anim_move_right : String = \"move_right\"
@export var anim_move_up : String = \"move_up\"
@export var anim_move_down : String = \"move_down\"

@export var anim_idle_right : String = \"idle_right\"
@export var anim_idle_up : String = \"idle_up\"
@export var anim_idle_down : String = \"idle_down\"

@export var anim_attack_right : String = \"attack_right\"
@export var anim_attack_up : String = \"attack_up\"
@export var anim_attack_down : String = \"attack_down\"

@export var anim_die : String = \"die\"

var character_direction : Vector2 = Vector2.ZERO
var last_direction : Vector2 = Vector2.DOWN
var is_attacking : bool = false
var is_dead : bool = false

func _ready():
	if not sprite:
		for child in get_children():
			if child is AnimatedSprite2D:
				sprite = child
				break
	if sprite:
		sprite.animation_finished.connect(_on_animation_finished)

func _physics_process(_delta):
	if is_dead:
		return

	if Input.is_action_just_pressed(\"attack\") and not is_attacking:
		start_attack()

	if is_attacking:
		velocity = Vector2.ZERO
		move_and_slide()
		return

	character_direction.x = Input.get_axis(\"move_left\", \"move_right\")
	character_direction.y = Input.get_axis(\"move_up\", \"move_down\")

	if character_direction != Vector2.ZERO:
		character_direction = character_direction.normalized()
		last_direction = character_direction
		velocity = character_direction * movement_speed
		update_animation(true)
	else:
		velocity = velocity.move_toward(Vector2.ZERO, movement_speed)
		update_animation(false)

	move_and_slide()

func update_animation(is_moving: bool):
	if not sprite:
		return
		
	var anim_to_play : String = \"\"

	if abs(last_direction.y) > abs(last_direction.x):
		sprite.flip_h = false
		if last_direction.y < 0:
			anim_to_play = anim_move_up if is_moving else anim_idle_up
		else:
			anim_to_play = anim_move_down if is_moving else anim_idle_down
	else:
		sprite.flip_h = last_direction.x < 0
		anim_to_play = anim_move_right if is_moving else anim_idle_right

	if sprite.animation != anim_to_play:
		sprite.play(anim_to_play)

func start_attack():
	if not sprite:
		return
		
	is_attacking = true
	var anim_to_play : String = \"\"

	if abs(last_direction.y) > abs(last_direction.x):
		sprite.flip_h = false
		if last_direction.y < 0:
			anim_to_play = anim_attack_up
		else:
			anim_to_play = anim_attack_down
	else:
		sprite.flip_h = last_direction.x < 0
		anim_to_play = anim_attack_right

	sprite.play(anim_to_play)

func die():
	is_dead = true
	velocity = Vector2.ZERO
	if sprite:
		sprite.play(anim_die)

func _on_animation_finished():
	if sprite and sprite.animation in [anim_attack_up, anim_attack_down, anim_attack_right]:
		is_attacking = false
"

